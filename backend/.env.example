# Copy this file to .env and fill in real values.
#
# NEVER put a real key in THIS file. .env is gitignored; .env.example is not,
# and is meant to be committed as a template. A key pasted here is a key
# published.

# SQLite by default; swap for a PostgreSQL URL when ready to move off the prototype DB.
DATABASE_URL=sqlite:///./finance_controller.db

# Root directory for raw/parsed/normalized/ground_truth data (defaults to ../data)
# DATA_ROOT=../data

# Deliberate pause between pipeline stages so a run is observable in the UI.
# Set to 0 for benchmarking or scripted seeding.
# BATCH_STAGE_DELAY_SECONDS=0.45

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the local Vite dev server; a deployed frontend (Vercel,
# Render static site, ...) must add its real origin here or every request
# gets silently blocked by CORS. Multiple origins: separate with commas.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Required for the AI Finance Controller agent. Gemini is checked first;
# without either key set, the agent endpoint returns a clear "not configured"
# message rather than failing oddly.
#
# The API reads this file once at startup -- RESTART the API after editing it.
GEMINI_API_KEY=
# Older models such as gemini-2.5-flash are closed to new API keys and return
# 404 for them. Override the default here if your key is entitled to a
# different model.
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic and OpenAI are equally supported -- the provider abstraction is
# not hard-wired to one vendor. Set whichever key you have; only one is needed.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Groq speaks the OpenAI chat-completions API, so it reuses the same
# provider code with a different base_url -- just as supported as the above.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# With several keys present, the first found wins in the order
# gemini -> anthropic -> openai -> groq. Set this to pin one explicitly:
#   AGENT_PROVIDER=groq
# Naming a provider whose key is missing is an error, not a silent fallback.
# AGENT_PROVIDER=
